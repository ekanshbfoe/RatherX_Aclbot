# Copy this file to .env and fill in your values.

# ── Required ────────────────────────────────────────────────
BOT_TOKEN=123456789:your_bot_token_from_botfather
OWNER_ID=123456789

# ── Supabase ────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# ── Feedback tickets (/feedback) ────────────────────────────
FEEDBACK_GROUP_ID=-1001234567890
FEEDBACK_TOPIC_ID=21

# ── Analytics alerts (new users / new groups) ───────────────
NOTIFICATION_LOG_GROUP=-1001234567890
NOTIFICATION_LOG_TOPIC_ID=18

# ── Webhook ─────────────────────────────────────────────────
# Public HTTPS URL of the server, without a trailing slash
WEBHOOK_URL=https://your-app.onrender.com
# Keep this as /webhook (set_webhook in main.py always uses /webhook)
WEBHOOK_PATH=/webhook
# Random string (A-Z, a-z, 0-9, _ and -, up to 256 chars). Leave empty to disable.
WEBHOOK_SECRET_TOKEN=

# Port to listen on (Render sets this automatically)
PORT=8080
